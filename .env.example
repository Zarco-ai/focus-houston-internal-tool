# Environment variables the app reads. Copy the ones you need; never commit
# real values. In production every one of these is set in Render's dashboard
# (the service's Environment tab), never in a file.
#
# This file is documentation. The app does not load .env files itself.

# --- Which configuration ---------------------------------------------------
# "development" on a laptop. Leave UNSET in production: unset means
# production, which refuses to start without SECRET_KEY and DATABASE_URL.
# run.py and seed.py set it to development for you.
FOCUS_ENV=development

# --- Required in production --------------------------------------------------
# Signs session cookies and CSRF tokens. At least 32 random characters.
# Render's "Generate" button makes one. Changing it signs everyone out.
SECRET_KEY=

# PostgreSQL connection URL. Render provides it (use the INTERNAL URL for the
# web service). postgres:// and postgresql:// are both accepted; production
# adds sslmode=require unless the URL already sets an sslmode.
DATABASE_URL=

# "Sign in with Google" client, from Google Cloud. Required in production;
# without them nobody could sign in, so the app refuses to start. On a laptop
# they are optional (the sign-in page says what's missing).
# See docs/GOOGLE_SIGN_IN_SETUP.md. NEVER commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These emails become admins the FIRST time they sign in,
# and only then -- someone removed later is not re-added by this. Optional
# once the first admin exists. Real emails go in Render, never in this file.
ADMIN_EMAILS=

# --- Optional ------------------------------------------------------------------
# Point the test suite at a different PostgreSQL (for CI). Defaults to the
# focus_test database in docker-compose.yml.
# TEST_DATABASE_URL=postgresql+psycopg://focus:focus-local-only@127.0.0.1:5433/focus_test

# run.py only (the laptop development server):
# PORT=5001
# HOST=127.0.0.1
# FLASK_DEBUG=0
